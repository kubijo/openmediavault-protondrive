{
  "type": "config",
  "id": "conf.service.protondrive.set",
  "title": "Proton Drive",
  "queryinfo": {
    "xpath": "//services/protondrive/sets/set",
    "iterable": true,
    "idproperty": "uuid"
  },
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuidv4"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "enable": {
      "type": "boolean",
      "default": true
    },
    "paths": {
      "type": "string"
    },
    "excludes": {
      "type": "string",
      "default": ""
    },
    "stopcontainers": {
      "type": "boolean",
      "default": false
    },
    "localkeep": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 2
    },
    "remotekeep": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 7
    },
    "containerids": {
      "type": "string",
      "default": ""
    },
    "composeprojects": {
      "type": "string",
      "default": ""
    },
    "composeapps": {
      "type": "string",
      "default": ""
    }
  }
}
