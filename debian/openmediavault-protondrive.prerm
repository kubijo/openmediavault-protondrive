#!/bin/sh
set -eu
case "$1" in
remove | upgrade | deconfigure)
    systemctl stop omv-protondrive-backup.timer 2>/dev/null || true
    if systemctl cat omv-protondrive-backup.service >/dev/null 2>&1; then
        systemctl stop omv-protondrive-backup.service
    fi
    /usr/sbin/omv-protondrive recover
    systemctl stop omv-protondrive.service 2>/dev/null || true
    ;;
esac
