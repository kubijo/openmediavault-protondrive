#!/bin/sh
set -eu

case "$1" in
    remove | upgrade | deconfigure)
        systemctl stop omv-protondrive-api.service omv-protondrive-controller.service 2>/dev/null || true
        systemctl stop omv-protondrive-backup.timer 2>/dev/null || true
        if systemctl cat omv-protondrive-backup.service >/dev/null 2>&1; then
            systemctl stop omv-protondrive-backup.service
        fi
        /usr/sbin/omv-protondrive recover
        # Keep failed recovery observable, then silence the intentional outage.
        if [ -f /etc/monit/conf.d/openmediavault-protondrive.conf ] && systemctl is-active --quiet monit; then
            /usr/sbin/omv-protondrive unmonitor
        fi
        systemctl stop omv-protondrive.service 2>/dev/null || true
        ;;
esac
